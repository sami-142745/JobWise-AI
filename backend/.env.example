# MongoDB connection string
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=job_recommender

# Auth
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: leverage a real LLM API. If empty, the local Ollama model (below)
# or the built-in rule-based agent is used. No API key is ever stored in code.
OPENAI_API_KEY=

# Server
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
SEED_JOBS=1

# ── Local Ollama integration ──────────────────────────────────────────
# Set OLLAMA_ENABLED=false to force offline rule-based mode (or leave true:
# the app automatically falls back to offline when Ollama is unavailable).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Any model you have pulled locally, e.g. qwen2.5-coder:7b, llama3.1:8b, mistral:7b
OLLAMA_MODEL=qwen2.5-coder:7b
# Seconds to wait for a model response (first run loads the model into memory).
OLLAMA_TIMEOUT=300
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.2