# MongoDB connection string
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=job_recommender

# Auth
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: leverage a real LLM. If empty, the built-in rule-based
# matching agent is used (works offline).
OPENAI_API_KEY=

# Server
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
SEED_JOBS=1