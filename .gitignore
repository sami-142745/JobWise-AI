# ── Environment / secrets ─────────────────────────────────────────────
# Never commit real keys, tokens, or .env files.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ── Python / Backend ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.pytest_cache/
.coverage
.coverage.*
.hypothesis/
htmlcov/
.tox/
.nox/
venv/
.venv/
env/
ENV/
virtualenv/

# App runtime data (uploaded resumes, logs) — never publish user files.
backend/uploads/*
!backend/uploads/.gitkeep
*.log

